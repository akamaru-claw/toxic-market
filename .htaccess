<IfModule mod_rewrite.c>
    # Security Headers
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
        Header set X-Frame-Options "DENY"
        Header set Referrer-Policy "strict-origin-when-cross-origin"
        Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # CSP: blocks inline execution by default; allows inline styles/scripts
        # currently required by the frontend. Move remaining inline code to
        # external files, then remove 'unsafe-inline' and 'unsafe-eval'.
        Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://mempool.space https://*.lnbits.com wss://*.lnbits.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;"
        Header set X-XSS-Protection "1; mode=block"
    </IfModule>

    # Cache control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>

# Force no-cache for HTML/PHP so updates are always visible
<FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

RewriteEngine On
RewriteBase /toxic-market/
    
    # Block access to sensitive files
    RewriteRule ^data/ - [F,L]
    RewriteRule ^includes/ - [F,L]
    
    # Card detail pages
    RewriteRule ^card/([0-9]+)$ card.php?id=$1 [QSA,L]
    # Listing detail pages
    RewriteRule ^listing/([a-zA-Z0-9]+)$ listing.php?id=$1 [QSA,L]
    # Seller profile pages
    RewriteRule ^seller/([0-9]+)$ seller.php?id=$1 [QSA,L]
    # Auction detail pages
    RewriteRule ^auction/([a-zA-Z0-9]+)$ auction.php?id=$1 [QSA,L]
    # Create listing page
    RewriteRule ^create$ create.php [QSA,L]
    # Create auction page
    RewriteRule ^create-auction$ create-auction.php [QSA,L]
    # Dashboard
    RewriteRule ^dashboard$ dashboard.php [QSA,L]
    # Set Builder
    RewriteRule ^set-builder$ set-builder.php [QSA,L]
    # Sitemap
    RewriteRule ^sitemap\.xml$ sitemap.php [QSA,L]
    # Image uploads - serve via PHP only (no direct access)
    RewriteRule ^uploads/ - [F,L]
    
    # SPA routing (only for non-existing files)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.html [QSA,L]
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
</IfModule>