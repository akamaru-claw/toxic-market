<IfModule mod_rewrite.c>
    # Security Headers
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
        Header set X-Frame-Options "DENY"
        Header set Referrer-Policy "strict-origin-when-cross-origin"
        Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    </IfModule>

    # Cache control — force reload for CSS/JS (versioned), cache images
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>

# Force PHP processing for .html files (they contain PHP code)
AddType application/x-httpd-php .html

# Force no-cache for HTML so updates are always visible
<FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

RewriteEngine On
    
    # Block access to sensitive files
    RewriteRule ^data/ - [F,L]
    RewriteRule ^includes/ - [F,L]
    
    # Card detail pages
    RewriteRule ^card/([0-9]+)$ /toxic-market/card.html?id=$1 [QSA,L]
    # Listing detail pages
    RewriteRule ^listing/([a-zA-Z0-9]+)$ /toxic-market/listing.html?id=$1 [QSA,L]
    # Seller profile pages
    RewriteRule ^seller/([0-9]+)$ /toxic-market/seller.html?id=$1 [QSA,L]
    # Auction detail pages
    RewriteRule ^auction/([a-zA-Z0-9]+)$ /toxic-market/auction.html?id=$1 [QSA,L]
    # Create listing page
    RewriteRule ^create$ /toxic-market/create.html [QSA,L]
    # Create auction page
    RewriteRule ^create-auction$ /toxic-market/create-auction.html [QSA,L]
    # Dashboard
    RewriteRule ^dashboard$ /toxic-market/dashboard.html [QSA,L]
    # Set Builder
    RewriteRule ^set-builder$ /toxic-market/set-builder.html [QSA,L]
    # Sitemap
    RewriteRule ^sitemap\.xml$ /toxic-market/sitemap.php [QSA,L]
    # Image uploads - serve via PHP only (no direct access)
    RewriteRule ^uploads/ - [F,L]
    
    # SPA routing (only for non-existing files)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ /toxic-market/index.html [QSA,L]
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
</IfModule>